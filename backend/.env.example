# ─────────────────────────────────────────────────────────────
# NAS Monitor 后端配置模板
# 复制为 .env 后按需填写。只填必填项即可跑起来；
# 未配置的可选服务会自动跳过，不会报错也不会显示空卡片。
# ─────────────────────────────────────────────────────────────

# ── 必填：访问令牌（客户端/网页端用它调用接口）──
# 建议用 `openssl rand -hex 24` 生成；App 首次启动时填入。
APP_API_TOKEN=CHANGE_ME_APP_TOKEN
# 网页端可单独用一个令牌（可留空，留空则只能用 APP_API_TOKEN）
WEB_API_TOKEN=
# 可选：App 扫码导入用的对外后端地址（含协议与端口）。
# 配了公网/反代入口就填这里，例如 https://monitor.example.com:23245；
# 留空则按浏览器访问的 Host 推断（适合纯内网使用）。
PUBLIC_BASE_URL=

# ── 必填：本机地址 ──
# 本 NAS 的地址（Glances / Home Assistant / New API 等本地服务默认基于此主机）
NAS_HOST=nas.example.com
# NAS 在本机组网里的地址（仅用于概览的 latency 字段，可留空）
NAS_MESH_IP=
# 局域网主网段前缀，同 MAC 多 IP 时优先保留该网段（默认 192.168.）
LAN_PREFIX=192.168.

# ── 基础监控：Glances（推荐，必装）──
# 默认按 http://{NAS_HOST}:61208 访问；Glances 端口不同时在这里覆盖
NAS_GLANCES=

# ── 可选：Home Assistant（硬盘温度、风扇、UPS、卷容量文案）──
HA_URL=
HA_TOKEN=

# ── 可选：路由器（爱快 iKuai）──
# 留空则不采集路由器数据（WAN/在线设备/测速卡片自动隐藏）
ROUTER_HOST=
IKUAI_PASS=
ROUTER_SERVICE_URL=

# ── 可选：本机服务探活（留空则该项不探测）──
NAS_SERVICE_NEW_API=
NAS_SERVICE_KUMA=
NAS_SERVICE_HA=
NAS_SERVICE_GITEA=
NAS_SERVICE_MIHOMO=
NAS_SERVICE_SAFELINE=
NAS_SERVICE_LUCKY=
NAS_SERVICE_NARRATOAI=
NAS_SERVICE_SMANGA=
NAS_SERVICE_FAN_DASHBOARD=
NEW_API_KEY=

# ── 可选：远程主机（云服务器等，留空则概览不显示）──
ALIYUN_HOST=
ALIYUN_PUBLIC_IP=
ALIYUN_NAME=
ALIYUN_GLANCES=
ALIYUN_SECURITY_URL=
ALIYUN_SECURITY_TOKEN=
ALIYUN_SERVICE_NEW_API=
ALIYUN_SERVICE_GLANCES=
ALIYUN_SERVICE_MIHOMO=
ALIYUN_SERVICE_CORAZA=
TENCENT_HOST=
TENCENT_PUBLIC_IP=
TENCENT_NAME=
TENCENT_GLANCES=
TENCENT_SECURITY_URL=
TENCENT_SECURITY_TOKEN=

# ── 可选：上游 OpenWrt（二级路由 WAN 出口流量回填）──
OPENWRT_WAN3_HOST=
OPENWRT_WAN3_PORT=22
OPENWRT_WAN3_USER=root
OPENWRT_WAN3_PASSWORD=
OPENWRT_WAN3_IFACE=pppoe-wan

# ── 可选：AnythingLLM 知识库问答 ──
ANYTHINGLLM_URL=
ANYTHINGLLM_API_KEY=
ANYTHINGLLM_WORKSPACE=nas-docker

# ── 可选：网页端一次性登录码 ──
WEB_BOOTSTRAP_CODE=
WEB_BOOTSTRAP_EXPIRES_AT=0

# ── 可选：WAN 口测速（爱快 + macvlan）──
SPEEDTEST_BINARY_HOST=
SPEEDTEST_NETWORK=
SPEEDTEST_WAN1_IP=
SPEEDTEST_WAN2_IP=
SPEEDTEST_WAN3_IP=

# ── 可选：WorkBuddy 账号池（网关页账号卡片 + 积分）──
# 注意：下面 *_AUTH_DIR / *_STATE_DIR 是**宿主机挂载源**（compose 用它做 bind mount），
# 必须填宿主上的真实目录；容器内运行时路径由 compose 的 environment 固定为
# /app/secrets/workbuddy-auths 等挂载点，不要在这里填容器内路径，否则挂载为空、积分整体失效。
WORKBUDDY_BASE=
WORKBUDDY_WAN1_BASE=
# 可选：第三个出口（例如跑在另一台设备上的上游）。留空则该分组自动跳过。
WORKBUDDY_WAN3_BASE=
# 以下均为**目录**（compose 只挂目录，不挂单文件；文件缺失只降级对应功能，不阻塞启动）。
# 容器内固定文件名：WorkBuddy 为 config.json，Pipio 为 pipio-admin-token.txt /
# pipio2-admin-token.txt，Hermes 为 jobs.json。
WORKBUDDY_CONFIG_DIR=
WORKBUDDY_WAN1_CONFIG_DIR=
WORKBUDDY_WAN3_CONFIG_DIR=
# 可选：Pipio 管理令牌目录（各放一个文件）与 Hermes cron 目录。
# 留空则挂 ./.docker-mounts/empty 下的空目录，相关卡片自动降级。
PIPIO_ADMIN_TOKEN_DIR=
PIPIO2_ADMIN_TOKEN_DIR=
HERMES_CRON_DIR=
WORKBUDDY_AUTH_DIR=
WORKBUDDY_WAN1_AUTH_DIR=
# 可选：第三个出口的账号在另一台设备上（本机不再挂它的 auths 目录）时，
# 填该设备上 workbuddy-manager 的地址与只读 API Token，用面板代查实时积分。
# 两者都留空则只读上游 /status（积分可能滞后或为 0）。
WORKBUDDY_WAN3_PANEL=
WORKBUDDY_WAN3_PANEL_TOKEN=
# 面板账号清单轮询间隔（秒）：用于「远端加号后快速重采」，默认 60。
WORKBUDDY_PANEL_WATCH_INTERVAL=60
WORKBUDDY_STATE_DIR=
# 可选：auths 目录监听周期（秒）。设 0 可关闭「加账号后秒级重采」。
WORKBUDDY_WATCH_ENABLED=1
WORKBUDDY_WATCH_INTERVAL=5
